APP_NAME=PokeMarket API
ENVIRONMENT=development
AI_PROVIDER=stub
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=*
MAX_IMAGE_BYTES=12000000
MAX_IMAGES=10
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
AUTH_SECRET=replace-with-at-least-32-random-characters
LEGACY_CLAIM_CODE=replace-with-a-separate-random-setup-code
ACCESS_TOKEN_TTL_SECONDS=2592000
PASSWORD_HASH_ITERATIONS=600000
R2_BUCKET_NAME=pokemart-images
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRESIGNED_URL_EXPIRY_SECONDS=3600
